{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/juan-freelance/Documents/proyectos/kakebot-backend/scripts/check-list-bullets.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/juan-freelance/Documents/proyectos/kakebot-backend/scripts/track-modified-file.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/juan-freelance/Documents/proyectos/kakebot-backend/scripts/check-session-params.js"
          }
        ]
      }
    ]
  }
}
